---
import '../styles/global.css';
import '../styles/updates.css';
import '../styles/v1.5.css';
import '../styles/v1.6.css';
import '../styles/v1.7.css';
interface Props { title?: string; description?: string; }
const { title = 'Perennial Fallout — Official Website', description = 'Perennial Fallout: music, shows and the band.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0b0b0d" />
<meta name="description" content={description} />
<title>{title}</title>
<link rel="icon" href="/assets/icons/logo.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Metal+Mania&display=swap" rel="stylesheet" />
</head>
<body><slot /></body>
</html>
