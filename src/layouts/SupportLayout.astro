---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  updated?: string;
}
const { title, eyebrow, description, updated = 'November 18, 2026' } = Astro.props;
---
<BaseLayout title={`${title} — Perennial Fallout`} description={description}>
  <div id="top"></div>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="support-header">
    <div class="content-wrap support-header-inner">
      <a class="support-brand" href="/" aria-label="Perennial Fallout home"><img src="/assets/icons/logo.svg" alt="Perennial Fallout" width="80" height="80" /></a>
      <nav class="support-top-links" aria-label="Support navigation"><a href="/">Home</a><a href="/privacy-policy/">Privacy</a><a href="/cookie-preferences/">Cookies</a></nav>
      <a href="/" class="support-home-link">← Back to site</a>
    </div>
  </header>
  <main id="main" class="support-main">
    <div class="support-hero textured">
      <div class="content-wrap support-hero-inner">
        <p class="support-kicker">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="support-description">{description}</p>
        <p class="support-updated">Last updated: {updated}</p>
      </div>
    </div>
    <div class="content-wrap support-main-grid">
      <nav class="support-subnav" aria-label="Support pages">
        <p>SUPPORT</p>
        <a href="/purchase-terms/" aria-current={Astro.url.pathname.startsWith('/purchase-terms') ? 'page' : undefined}>Purchase Terms</a>
        <a href="/privacy-policy/" aria-current={Astro.url.pathname.startsWith('/privacy-policy') ? 'page' : undefined}>Privacy Policy</a>
        <a href="/terms-of-use/" aria-current={Astro.url.pathname.startsWith('/terms-of-use') ? 'page' : undefined}>Terms of Use</a>
        <a href="/cookie-preferences/" aria-current={Astro.url.pathname.startsWith('/cookie-preferences') ? 'page' : undefined}>Cookie Preferences</a>
      </nav>
      <article class="support-article"><slot /></article>
    </div>
  </main>
  <Footer />
</BaseLayout>
