---
import { siteConfig } from '../data/site';
---
      <section class="music-player" id="music" aria-label="Featured music player">
        <p class="eyebrow">New single</p>
        <h1 class="song-name" id="song-title">{siteConfig.songTitle}</h1>
        <p class="song-artist">{siteConfig.artist}</p>
        <audio id="featured-audio" preload="metadata" src={siteConfig.audioPath}></audio>
        <div class="player-controls" aria-label="Audio player controls">
          <button type="button" class="player-control repeat" id="repeat" aria-label="Enable repeat" aria-pressed="false" title="Repeat"><img src="/assets/icons/repeat.svg" alt=""></button>
          <button type="button" class="player-control" id="previous" aria-label="Restart song" title="Restart song"><img src="/assets/icons/skip-back-fill.svg" alt=""></button>
          <button type="button" class="player-play" id="play-pause" aria-label="Play song" title="Play song">
            <svg class="play-shape" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>
            <svg class="pause-shape" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1"/><rect x="13.5" y="5" width="4" height="14" rx="1"/></svg>
          </button>
          <button type="button" class="player-control" id="next" aria-label="Restart song" title="Restart song"><img src="/assets/icons/skip-forward-fill.svg" alt=""></button>
          <div class="volume-control" id="volume-control">
            <button type="button" class="player-control" id="mute" aria-label="Adjust volume" aria-controls="volume-panel" aria-expanded="false" title="Adjust volume"><svg viewBox="0 0 24 24" aria-hidden="true" class="speaker-icon"><path d="M3 9v6h4l5 4V5L7 9zM16 9c1 .7 1.5 1.7 1.5 3S17 14.3 16 15M18.5 6c2 1.4 3 3.4 3 6s-1 4.6-3 6"/></svg></button>
            <div class="volume-panel" id="volume-panel" aria-hidden="true" inert>
              <label class="sr-only" for="volume-range">Music volume</label>
              <input id="volume-range" type="range" min="0" max="100" value="75" aria-label="Music volume" aria-orientation="vertical">
            </div>
          </div>
        </div>
        <div class="progress-row"><label for="track-progress" class="sr-only">Playback position</label><input type="range" id="track-progress" aria-label="Seek within 45-second music preview" aria-valuetext="0 seconds of 45" min="0" max="1000" step="1" value="0" style="--seek-progress:0%"><output class="remaining-time" id="remaining-time" aria-label="Time remaining in 45-second preview">0:45</output></div>
        <div class="player-actions"><button type="button" class="pill pill-solid" data-coming-soon="Track purchases">Buy Track</button><button type="button" class="pill pill-outline" id="share-track" aria-label="Share The Way by Perennial Fallout">Share</button></div>
        <p id="player-feedback" class="sr-only" role="status"></p>
        <p id="share-feedback" class="sr-only" role="status" aria-live="polite"></p>
      </section>
