---
// Newsletter signup retains the original form and visual styling.
// The public Turnstile site key is set as a Cloudflare Pages BUILD variable.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<section class="newsletter textured" id="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter-texture-flicker" id="newsletter-texture-flicker" aria-hidden="true"></div>
  <div class="newsletter-content content-wrap">
    <h2 class="section-heading" id="newsletter-heading">Enter The Fallout</h2>
    <p>Get first access to new music, upcoming shows,<br class="desktop-break"> exclusive merch, and band updates.</p>
    <form class="newsletter-form" id="newsletter-form" novalidate data-turnstile-enabled={turnstileSiteKey ? 'true' : 'false'}>
      <label class="sr-only" for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" placeholder="Enter your email address" maxlength="254" required>
      <button class="pill pill-solid" type="submit">SUBSCRIBE</button>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="newsletter-honeypot" aria-hidden="true" />
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-appearance="interaction-only" data-action="newsletter_signup"></div>}
    </form>
    <p id="newsletter-message" class="form-message" role="status" aria-live="polite"></p>
    <p class="newsletter-consent">By subscribing, you agree to receive email updates from Perennial Fallout. <a href="/privacy-policy/">Privacy notice</a>.</p>
  </div>
</section>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
