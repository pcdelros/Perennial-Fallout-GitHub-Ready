---
// Footer — semantic, server-rendered Astro component.
---
<footer class="site-footer textured" id="footer">
  <div class="footer-inner content-wrap">
    <div class="footer-identity"><a href="#home" aria-label="Perennial Fallout, back to top"><img class="footer-logo" src="/assets/icons/logo.svg" width="180" height="180" alt="Perennial Fallout"></a>
      
      <div class="socials" aria-label="Music and social profiles">
        <button type="button" data-social="Spotify" title="Spotify" aria-label="Spotify"><img src="/assets/icons/spotify-fill.svg" alt=""></button>
        <button type="button" data-social="Apple Music" title="Apple Music" aria-label="Apple Music"><img src="/assets/icons/apple-fill.svg" alt=""></button>
        <button type="button" data-social="YouTube" title="YouTube" aria-label="YouTube"><img src="/assets/icons/youtube-fill.svg" alt=""></button>
        <button type="button" data-social="Facebook" title="Facebook" aria-label="Facebook"><img src="/assets/icons/facebook-circle-fill.svg" alt=""></button>
      </div>
    </div>
    <div class="footer-navs">
      <details class="footer-column" open><summary>Quick Links <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="footer-links-shell"><div class="footer-links"><a href="#home">Home</a><a href="#music">Music</a><a href="#shows">Live Shows</a><button type="button" data-coming-soon="Merchandise">Merchandise</button><a href="#band">About Us</a><button type="button" data-coming-soon="EPK">EPK</button></div></div>
      </details>
      <details class="footer-column" open><summary>Support <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="footer-links-shell"><div class="footer-links"><button type="button" data-coming-soon="Purchase terms">Purchase Terms</button><button type="button" data-coming-soon="Privacy policy">Privacy Policy</button><button type="button" data-coming-soon="Terms of use">Terms of Use</button><button type="button" data-coming-soon="Cookie preferences">Cookie Preferences</button></div></div>
      </details>
    </div>
  </div>
  <div class="footer-bottom content-wrap"><span>© <span id="copyright-year">2026</span> Perennial Fallout. All Rights Reserved.</span><a href="#home" class="back-to-top">Back to top ↑</a></div>
</footer>
