---
import MusicPlayer from "./MusicPlayer.astro";
---
<section class="hero" id="home" aria-label="Perennial Fallout featured single">
    <div class="hero-art" aria-hidden="true"><picture><source media="(min-width: 761px)" srcset="/assets/images/hero-desktop.webp" type="image/webp"><img src="/assets/images/hero-mobile-v171.webp" width="1070" height="1100" alt="" fetchpriority="high"></picture></div>
    <div class="hero-audio-glow" aria-hidden="true"></div>
    <canvas class="hero-smoke" id="hero-smoke" aria-hidden="true"></canvas>
    <div class="hero-shadow" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-space" aria-hidden="true"></div>
      <MusicPlayer />
    </div>
  </section>
