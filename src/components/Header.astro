---
// Header — semantic, server-rendered Astro component.
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <button class="menu-toggle icon-button" type="button" id="menu-toggle" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a class="site-logo" href="#home" aria-label="Perennial Fallout — Home"><img src="/assets/icons/logo.svg" alt="Perennial Fallout logo" width="120" height="120"></a>
    <nav class="desktop-navigation" aria-label="Main navigation">
      <a href="#home">Home</a>
      <a href="#shows">Live Shows</a>
      <a href="#music">Music</a>
      <button type="button" data-coming-soon="EPK">EPK</button>
    </nav>
    <button class="nav-audio" id="nav-audio" type="button" aria-label="Play music" title="Play music" aria-pressed="false">
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
    </button>
  </div>
  <nav class="mobile-navigation" id="mobile-navigation" aria-label="Mobile navigation" aria-hidden="true" inert>
    <a href="#home">Home</a>
    <a href="#shows">Live Shows</a>
    <a href="#music">Music</a>
    <a href="#band">Meet The Band</a>
    <button type="button" data-coming-soon="EPK">EPK</button>
  </nav>
</header>
<div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
